<nav class="mq-sidebar @(Collapsed ? "collapsed" : "")">
    <div class="mq-sidebar-head">
        <span>Server</span>
    </div>

    <div class="mq-sidebar-list">
        @foreach (var server in Servers)
        {
            bool isSelected = server.Name == SelectedServer;
            string alertClass = server.WorstStatus == QueueStatus.Error ? "error" : "warn";

            <div class="mq-srv @(isSelected ? "on" : "")" title="@server.Name" @onclick="() => OnSelect.InvokeAsync(server.Name)">
                <div class="mq-srv-avatar">
                    @Initials(server.Name)
                    @if (server.Problems > 0)
                    {
                        <span class="mq-srv-alert @alertClass" title="@server.Problems problem(s)"></span>
                    }
                </div>
                <div class="mq-srv-meta">
                    <div class="mq-srv-name">@server.Name</div>
                    <div class="mq-srv-sub">
                        @if (server.Loaded)
                        {
                            <span title="Items">@server.Items.ToNumberText() Items</span>
                            @if (server.Unconfirmed > 0)
                            {
                                <span title="Unconfirmed Items">@server.Unconfirmed.ToNumberText() Unc.</span>
                            }
                            @if (server.Problems > 0)
                            {
                                <span class="mq-text-@alertClass">⚠ @server.Problems</span>
                            }
                        }
                        else
                        {
                            <span>loading…</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Collapsed && !string.IsNullOrEmpty(SelectedServerUrl))
    {
        <div class="mq-sidebar-foot">
            <div class="mq-mono" title="Url">@SelectedServerUrl</div>
            <div>Filter: <span class="mq-mono">@SelectedServerFilter</span></div>
        </div>
    }
</nav>

@code {
    [Parameter] public IEnumerable<ServerSummary> Servers { get; set; } = [];
    [Parameter] public string SelectedServer { get; set; } = "";
    [Parameter] public string? SelectedServerUrl { get; set; }
    [Parameter] public string? SelectedServerFilter { get; set; }
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback<string> OnSelect { get; set; }

    private static string Initials(string name)
    {
        var parts = name.Split([' ', '-', '_', '.', '+'], StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
        };
    }
}
