@inherits ErrorBoundary
@inject IDialogService DialogService



@code {
    protected override async Task OnErrorAsync(Exception exception)
    {
        var parameters = new DialogParameters<ErrorDialog>
        {
            { x => x.Content, exception.Message }
        };

        var dialog = await DialogService.ShowAsync<ErrorDialog>("Error", parameters);
        await dialog.Result;

        // allow further errors to be reported, otherwise repeated exceptions end the circuit
        Recover();
    }
}