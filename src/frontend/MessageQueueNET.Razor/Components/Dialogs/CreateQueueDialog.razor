@inject DashboardService DashboardService
@inject ISnackbar Snackbar

@inherits BaseComponent

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Color="Color.Primary" />Create queue
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">
            Namespace: <span class="mq-mono">@DashboardService.CreateQueuePattern()</span>
        </MudText>
        <MudTextField T="string" Style="width:600px;max-width:100%"
                      Label="Name of the new queue"
                      Variant="Variant.Outlined"
                      @bind-Value="_newQueueName"
                      Immediate="true"
                      AutoFocus="true"
                      OnKeyDown="OnKeyDown"
                      Required="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="string.IsNullOrWhiteSpace(_newQueueName)"
                   OnClick="Submit">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    private string _newQueueName = "";

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _newQueueName = DashboardService.CreateQueuePattern().Replace("*", "");
    }

    private void Cancel() => MudDialog?.Cancel();

    async private Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await Submit();
        }
    }

    async private Task Submit()
    {
        if (String.IsNullOrWhiteSpace(_newQueueName))
        {
            return;
        }

        var queueName = _newQueueName.Trim();
        var prefix = DashboardService.CreateQueuePattern().Replace("*", "");
        var fullName = queueName.StartsWith(prefix) ? queueName : prefix + queueName;

        if (await DashboardService.CreateQueue(queueName))
        {
            Snackbar.Add($"{fullName}: created", Severity.Success);
            MudDialog?.Close(DialogResult.Ok(fullName));
        }
    }
}
