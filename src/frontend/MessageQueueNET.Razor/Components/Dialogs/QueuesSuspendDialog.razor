@inject DashboardService DashboardService
@inject ISnackbar Snackbar

@inherits BaseComponent

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.PauseCircleOutline" Color="Color.Primary" />
            Suspend by filter: <span class="mq-mono">@QueueFilter</span>
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">
            Sets the state for all queues matching the filter.
        </MudText>
        <MudCheckBox T="bool" Label="Suspend enqueue" @bind-Value="_suspendEnqueue" Color="Color.Error" />
        <MudCheckBox T="bool" Label="Suspend dequeue" @bind-Value="_suspendDequeue" Color="Color.Error" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Submit">Apply</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string QueueFilter { get; set; } = "*";
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    private bool _suspendDequeue;
    private bool _suspendEnqueue;

    private void Cancel() => MudDialog?.Cancel();

    async private Task Submit()
    {
        await DashboardService.SetQueuesSuspend(QueueFilter, _suspendEnqueue, _suspendDequeue);

        Snackbar.Add($"{QueueFilter}: Enqueue {(_suspendEnqueue ? "suspended" : "active")}, Dequeue {(_suspendDequeue ? "suspended" : "active")}", Severity.Success);
        MudDialog?.Close(DialogResult.Ok(true));
    }
}
