# Variables for docker-compose.yml. Copy this file to .env (same folder) and fill in the values.
# .env is ignored by git: it holds the secrets of your installation.
#
# Create a random secret (hex, so it is safe in URLs):
#   [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(24)).ToLower()
# Hash of a secret for the server (sha256:<hex>):
#   'sha256:' + [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData([Text.Encoding]::UTF8.GetBytes('<secret>'))).ToLower()
#   Linux: echo "sha256:$(printf '%s' '<secret>' | sha256sum | cut -d' ' -f1)"

# image version (git tag without 'v', e.g. 4.0.0) or latest
MQ_TAG=latest

# host ports; the dashboard has no login and is bound to 127.0.0.1 (set MQ_DASHBOARD_BIND=0.0.0.0 to expose it)
MQ_PORT=9091
MQ_DASHBOARD_PORT=9090
MQ_DASHBOARD_BIND=127.0.0.1

# OpenAPI document and Scalar UI (/scalar): true or false
MQ_OPENAPIUI=false

# --- client for your applications (role write) -----------------------------------------------------
# Applications use http://<MQ_APP_CLIENT_ID>:<secret>@<host>:9091 - only the hash is stored here.
MQ_APP_CLIENT_ID=app
MQ_APP_CLIENT_SECRET_HASH=sha256:...

# --- client for the dashboard ----------------------------------------------------------------------
MQ_DASHBOARD_CLIENT_ID=dashboard
# the secret in plain text (the dashboard sends it to the server); use URL-safe characters (e.g. hex)
MQ_DASHBOARD_CLIENT_SECRET=change-me
# hash of exactly MQ_DASHBOARD_CLIENT_SECRET (a different value => 401 in the dashboard)
MQ_DASHBOARD_CLIENT_SECRET_HASH=sha256:...
# read: only view queues; write/admin: also create, suspend and delete queues from the dashboard
MQ_DASHBOARD_ROLE=read
